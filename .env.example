# Kapi Stay Concierge — Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or secret keys to version control.

# Supabase Connection (Client-Side Publishable)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Application Site URL (used for OAuth redirect callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Privileged Access (Server-Side ONLY - NEVER commit or expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# SePay Webhook Verification & Configuration (Server-Side ONLY)
SEPAY_WEBHOOK_SECRET=
SEPAY_RECEIVING_ACCOUNT_NO=

# VietQR Payment Display Configuration (Client-Side Publishable)
NEXT_PUBLIC_VIETQR_BANK_ID=
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=
